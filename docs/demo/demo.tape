# VHS tape for the WOUF README demo clip.
# Regenerate from the repo root:  vhs docs/demo/demo.tape

Output docs/demo/demo.gif
Output docs/demo/demo.mp4

Set FontSize 15
Set Width 940
Set Height 620
Set Padding 18
Set Theme "Catppuccin Mocha"
Set TypingSpeed 40ms

Hide
Type "export PATH=$PWD/.venv/bin:$PATH && clear"
Enter
Show

Type "python docs/demo/demo_reel.py"
Enter
Sleep 50s
